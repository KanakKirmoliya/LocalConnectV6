# =============================================================================
# LocalConnect / NearNest Environment Configuration
# =============================================================================
# NOTE: Never commit actual passwords or connection strings to Git.
# Copy this file to .env and replace the placeholders below.
#
# If your password contains special characters like @, :, /, ?, #, or %,
# encode them using standard URL percent-encoding (e.g. '@' -> '%40', '#' -> '%23').
# =============================================================================

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/NearNest?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Private document vault (identity & property-ownership documents)
# =============================================================================
# REQUIRED in production. Documents are encrypted at rest with this key (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and backed up separately: documents cannot be read without it.
DOCUMENT_ENCRYPTION_KEY=
# Optional: absolute path for encrypted document files (default: server/private_uploads/verification)
# PRIVATE_UPLOAD_DIR=

# Room listing: set to true to require admin-verified owner identity + ownership documents before a room can be listed/booked.
# Default (unset/false): owners list a room just by giving its full address; the Room/Property ID is generated from the address (admin-only).
REQUIRE_OWNER_VERIFICATION=false

# --- Room location identity (one room listing per physical GPS spot) ---
# Two room listings closer than this many metres are treated as the same location (HTTP 409). 0 disables the rule.
ROOM_DUPLICATE_RADIUS_M=10
# Worst GPS accuracy (metres) accepted when a room location is sent as "gps". Less accurate fixes must be retried or pinned manually.
ROOM_MAX_GPS_ACCURACY_M=100
